            "editorMode": "code",
            "exemplar": false,
            "expr": "(\n  sum(container_memory_working_set_bytes{image!=\"\", cluster=~\"$cluster\"}) by (namespace)\n  /\n  sum(machine_memory_bytes{cluster=~\"$cluster\"})\n) * 100\nOR\n(\n  count by (namespace) (kube_namespace_created{cluster=~\"$cluster\"}) * 0\n)",
            "format": "table",
            "instant": true,
            "legendFormat": "{{Memory Usage}}",
            "range": false,
            "refId": "A"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "exemplar": false,
            "expr": "(\n  sum by(namespace) (\n    rate(container_cpu_usage_seconds_total{image!=\"\", cluster=~\"$cluster\"}[$__rate_interval])\n  )\n  /\n  sum(machine_cpu_cores{cluster=~\"$cluster\"})\n) * 100\nOR on(namespace)\n(\n  count by(namespace) (kube_namespace_created{cluster=~\"$cluster\"}) * 0\n)",
            "format": "table",
            "instant": true,
            "legendFormat": "{{CPU usage  %}}",
            "range": false,
            "refId": "B"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "exemplar": false,
            "expr": "(\n  sum by(namespace) (\n    kube_pod_container_resource_requests{resource=\"cpu\", cluster=~\"$cluster\"}\n  )\n  /\n  sum(machine_cpu_cores{cluster=~\"$cluster\"})\n) * 100\nOR on(namespace)\n(\n  count by(namespace) (kube_namespace_created{cluster=~\"$cluster\"}) * 0\n)",
            "format": "table",
            "instant": true,
            "legendFormat": "{{Request CPU %}}",
            "range": false,
            "refId": "C"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "exemplar": false,
            "expr": "(\n  sum by(namespace) (\n    kube_pod_container_resource_requests{resource=\"memory\", cluster=~\"$cluster\"}\n  )\n  /\n  sum(machine_memory_bytes{cluster=~\"$cluster\"})\n) * 100\nOR on(namespace)\n(\n  count by(namespace) (kube_namespace_created{cluster=~\"$cluster\"}) * 0\n)",
            "format": "table",
            "instant": true,
            "legendFormat": "{{Memory Request }}",
            "range": false,
            "refId": "D"
