            "editorMode": "code",
            "exemplar": false,
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",image!=\"\", container!=\"\", cluster=~\"$cluster\"}[$__rate_interval])) by (pod)",
