            "editorMode": "code",
            "exemplar": false,
            "expr": "sum(kube_pod_container_resource_requests{namespace=~\"$namespace\", resource=\"memory\", job=~\"$job\", cluster=~\"$cluster\"}) by (pod)",
            "format": "table",
            "instant": true,
            "legendFormat": "__auto",
            "range": false,
            "refId": "E"
