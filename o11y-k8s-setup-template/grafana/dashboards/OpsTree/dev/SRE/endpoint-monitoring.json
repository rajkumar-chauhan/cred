        },
        "pluginVersion": "12.4.0-19913286788",
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DATASOURCE}"
            },
            "editorMode": "code",
            "expr": "max by (instance,rems_application_group, rems_service) (\n  probe_success{\n    rems_environment=\"$env\",\n    rems_application_group=~\"$application_group\",\n    rems_service=~\"$service\",\n    instance=~\"$instance\"\n  }\n)",
            "format": "table",
            "instant": true,
            "interval": "",
            "legendFormat": "",
