            },
            "editorMode": "code",
            "expr": "max by (instance, rems_application_group, rems_service) (\n  (probe_ssl_earliest_cert_expiry{\n    rems_environment=\"$env\",\n    rems_application_group=~\"$application_group\",\n    rems_service=~\"$service\",\n    instance=~\"$instance\"\n  } - time()) / 3600 / 24\n)",
            "format": "table",
            "instant": true,
            "interval": "",
            "legendFormat": "",
            "refId": "B"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DATASOURCE}"
            },
            "editorMode": "code",
            "expr": "max by (instance, rems_application_group, rems_service) (\n  (probe_ssl_earliest_cert_expiry{\n    rems_environment=\"$env\",\n    rems_application_group=~\"$application_group\",\n    rems_service=~\"$service\",\n    instance=~\"$instance\"\n  } - time()) / 3600 / 24\n)",
            "format": "table",
            "instant": true,
            "interval": "",
            "legendFormat": "",
