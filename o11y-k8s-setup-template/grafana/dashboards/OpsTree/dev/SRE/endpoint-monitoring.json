      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DATASOURCE}"
        },
        "description": "\u003cp\u003e\u003cstrong\u003eInstance\u003c/strong\u003e – The endpoint URL being probed.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eStatus\u003c/strong\u003e – Indicates whether the probe is UP or DOWN.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eCode\u003c/strong\u003e – HTTP response code returned by the service.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eSSL\u003c/strong\u003e – Shows whether SSL/TLS is enabled and valid.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eTLS Version\u003c/strong\u003e – The TLS protocol version used for HTTPS.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eSSL Cert Expiry (days)\u003c/strong\u003e – Days remaining before the SSL certificate expires.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eSSL Cert Expiry Color Rules\u003c/strong\u003e – (-365 to 7 days → \u003cspan style='color:red;font-weight:bold;'\u003eRed\u003c/span\u003e, 8 to 15 days → \u003cspan style='color:#EAB839;font-weight:bold;'\u003eYellow\u003c/span\u003e, 16+ days → \u003cspan style='color:green;font-weight:bold;'\u003eGreen\u003c/span\u003e)\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eProbe Duration (s)\u003c/strong\u003e – Total time taken for the HTTP probe to complete.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eDNS Lookup Duration (s)\u003c/strong\u003e – Time taken for DNS resolution.\u003c/p\u003e",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "custom": {
              "align": "center",
              "cellOptions": {
                "type": "auto"
              },
              "filterable": true,
              "footer": {
                "reducers": []
              },
              "inspect": false
            },
            "mappings": [],
            "min": 0,
            "noValue": "N/A",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "SSL Cert Expiry (days)"
              },
              "properties": [
                {
                  "id": "decimals",
                  "value": 0
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "transparent",
                        "value": 0
                      },
                      {
                        "color": "red",
                        "value": -365
                      },
                      {
                        "color": "red",
                        "value": 7
                      },
                      {
                        "color": "#EAB839",
                        "value": 8
                      },
                      {
                        "color": "green",
                        "value": 16
                      }
                    ]
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Probe Duration (s)"
              },
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "mode": "basic",
                    "type": "gauge"
                  }
                },
                {
                  "id": "min",
                  "value": 0
                },
                {
                  "id": "max",
                  "value": 365
                },
                {
                  "id": "custom.filterable",
                  "value": false
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Status"
              },
              "properties": [
                {
                  "id": "mappings",
                  "value": [
                    {
                      "options": {
                        "0": {
                          "text": "DOWN"
                        },
                        "1": {
                          "text": "UP"
                        }
                      },
                      "type": "value"
                    }
                  ]
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "red",
                        "value": 0
                      },
                      {
                        "color": "green",
                        "value": 1
                      }
                    ]
                  }
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "mode": "gradient",
                    "type": "color-background"
                  }
                },
                {
                  "id": "custom.width",
                  "value": 130
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Code"
              },
              "properties": [
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "rgba(0, 0, 0, 0)",
