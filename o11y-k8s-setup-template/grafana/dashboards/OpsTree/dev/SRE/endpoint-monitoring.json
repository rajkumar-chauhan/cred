            "editorMode": "code",
            "expr": "max by (instance, rems_application_group, rems_service) (\n  probe_http_status_code{\n    rems_environment=\"$env\",\n    rems_application_group=~\"$application_group\",\n    rems_service=~\"$service\",\n    instance=~\"$instance\"\n  }\n) \u003e 0",
            "format": "table",
            "instant": true,
            "interval": "",
            "legendFormat": "",
            "refId": "D"
