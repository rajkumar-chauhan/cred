            "editorMode": "code",
            "expr": "max by (instance, rems_application_group, rems_service) (\n  avg_over_time(\n    probe_duration_seconds{\n      rems_environment=\"$env\",\n      rems_application_group=~\"$application_group\",\n      rems_service=~\"$service\",\n      instance=~\"$instance\"\n    }[1m]\n  )\n)",
            "format": "table",
